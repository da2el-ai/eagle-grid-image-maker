{
  "name": "eagle-grid-image-maker",
  "version": "0.1.0",
  "private": true,
  "description": "Eagle で選んだ画像を格子状に並べて、1枚のグリッド画像として書き出すプラグイン",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@types/node": "18.19.130",
    "@vitejs/plugin-vue": "5.2.4",
    "sharp": "0.32.6",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12"
  }
}
